# ==================== 自定义提交配置 ====================
# 用来把 SukiSU 和 SUSFS 固定到指定提交（比如最新提交把构建搞坏了的时候）
#
# 使用说明:
#   1. 将 custom 设为 true 启用
#   2. 在对应配置项后填入 commit hash
#   3. 留空表示使用该分支的最新提交
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=false

# SUSFS 的 commit hash（仅 custom=true 时生效）
gki-android14-6.1=

# SukiSU 的 commit hash（仅 custom=true 时生效）
sukisu=
