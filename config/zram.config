# ZRAM 压缩算法配置片段
# 由 build.yml 工作流在启用 use_zram 时追加到 defconfig
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_842=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
# lz4kd.patch 会把默认压缩算法改掉（最终落到 lzo），显式选回与原厂一致的 lzo-rle；
# lz4 / lz4k / lz4kd 等增强算法仍可在运行时通过 comp_algorithm 切换
CONFIG_ZRAM_DEF_COMP_LZORLE=y
